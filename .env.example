AMI_HOST=127.0.0.1
AMI_PORT=5038
AMI_USERNAME=keycrm
AMI_SECRET=change-me

HTTP_PORT=8080
HTTP_SHARED_SECRET=change-me

KEYCRM_WEBHOOK_URL=https://example.invalid/replace-with-keycrm-webhook-url

EXTENSION_LENGTH=4
ORIGINATE_CHANNEL_TEMPLATE=PJSIP/{ext}
ORIGINATE_CONTEXT=from-internal
ORIGINATE_TIMEOUT_MS=30000
INBOUND_CONTEXTS=from-trunk,ext-did

# Optional: send a recording link (audio_url) with the "completed" state.
# RECORDING_BASE_URL must serve RECORDING_DIR over HTTP(S); enabling it also
# subscribes to the AMI "dialplan" class to read MIXMONITOR_FILENAME VarSets.
# RECORDING_BASE_URL=https://pbx.example.com/monitor
# RECORDING_DIR=/var/spool/asterisk/monitor

# Optional smart routing: ask KeyCRM who manages the calling client and ring
# that manager first; fall back to the normal flow if they don't pick up.
# ROUTING_ENABLED=true
# ROUTING_CONTEXT=from-internal
# ROUTING_MANAGER_RING_MS=15000
# ROUTING_LOOKUP_TIMEOUT_MS=1500
# ROUTING_FALLBACK=from-pstn-crm,s,1   # default: where the call first arrived

WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_MAX_RETRIES=5
WEBHOOK_RETRY_BASE_MS=500

# Safety nets against runaway resource usage (all optional, sane defaults below)
MAX_CONCURRENT_CALLS=50
STALE_CALL_MAX_AGE_MS=14400000
STALE_SWEEP_INTERVAL_MS=300000

LOG_LEVEL=info
