[Unit]
Description=KeyCRM <-> Asterisk AMI telephony bridge
After=network.target asterisk.service
Wants=asterisk.service

[Service]
Type=simple
WorkingDirectory=/opt/keycrm-asterisk
EnvironmentFile=/opt/keycrm-asterisk/.env
ExecStart=/usr/bin/node /opt/keycrm-asterisk/src/index.js
Restart=always
RestartSec=5
User=keycrm-telephony
Group=keycrm-telephony
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
